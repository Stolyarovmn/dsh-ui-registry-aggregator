{
  "name": "@stolyarovmn/dsh-ui-registry-aggregator",
  "version": "0.5.1-rc.1",
  "description": "Federated plugin discovery and update UI for DeepSeek Harness 0.2.x, integrated with the native Plugin Manager.",
  "author": {
    "name": "Stolyarovmn",
    "url": "https://github.com/Stolyarovmn"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./source-core": "./source-core.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:pack": "npm pack --dry-run --json"
  },
  "files": [
    "index.js",
    "client.js",
    "source-core.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "registry",
    "plugin-discovery",
    "plugin-updates"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "ipaddr.js": "^2.2.0",
    "undici": "^7.16.0",
    "semver": "^7.8.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "catalog": {
      "category": "ui",
      "summary": {
        "en": "Discover plugins from federated sources and surface updates through the native DSH Plugin Manager.",
        "zh": "从聚合来源发现插件，并通过 DSH 原生 Plugin Manager 提供更新信息。"
      },
      "capabilities": [
        "slots",
        "network",
        "plugin-manager"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stolyarovmn/dsh-ui-registry-aggregator.git"
  },
  "homepage": "https://github.com/Stolyarovmn/dsh-ui-registry-aggregator",
  "bugs": {
    "url": "https://github.com/Stolyarovmn/dsh-ui-registry-aggregator/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "icon": "./icon.svg"
}
